{
  "name": "billsr",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Billsr is organized as a React/Vite web client and a separate Express API. The API uses MongoDB through Mongoose.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "server": "npm --prefix backend run dev",
    "client": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "dev:api": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "lint": "npm --prefix frontend run lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naveenjoshy/billsr.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/naveenjoshy/billsr/issues"
  },
  "homepage": "https://github.com/naveenjoshy/billsr#readme"
}
